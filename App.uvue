<!-- 主组件（所有页面都是在这里进行切换的，是应用入口文件。但它本身不是页面，这里不能编写视图元素，也就是没有<template>） -->
<script lang="uts">
  import store from '@/store'
  import cacheKey, { getCache, setCache, removeCache } from '@/utils/cache'

  export default {
    globalData: {  
      callbackId: 0
    },
    /**
     * 监听应用初始化（应用初始化完成时触发，全局只触发一次）
     * @param {OnLaunchOptions} options
     */
    onLaunch(options: OnLaunchOptions): void {
      console.log('App Launch')
      this.setAndOnAppTheme()
      this.checkSoterAuth()
    },
    /**
     * 监听应用显示（应用启动，或从后台进入前台显示时触发）
     * @param {OnShowOptions} options
     */
    onShow(options: OnShowOptions): void {
      console.log('App Show')
    },
    /**
     * 监听应用隐藏（应用从前台进入后台时触发）
     */
    onHide(): void {
      console.log('App Hide')
    },
    /**
     * 监听应用退出（仅支持 Android 和 HarmonyOS）
     */
    onExit() {
      console.log('App Exit')
      this.offAppTheme()
    },
    /**
     * 监听应用错误（应用发生脚本错误或API调用报错时触发）
     * @param {any} error
     */
    onError(error: any): void {
      console.log('App Error', error)
    },
    methods: {
      /**
       * 设置应用主题并开启监听系统主题变化
       */
      setAndOnAppTheme(): void {
        // #ifdef APP
        (store['changeTheme'] as (appTheme: 'auto' | 'light' | 'dark' | null) => void)(null)

        this.globalData.callbackId = uni.onOsThemeChange((res: OsThemeChangeResult) => {
          (store['changeTheme'] as (appTheme: 'auto' | 'light' | 'dark' | null) => void)(null)
        })
        // #endif
      },
      /**
       * 取消监听系统主题变化
       */
      offAppTheme(): void {
        // #ifdef APP
        uni.offOsThemeChange(this.globalData.callbackId)
        // #endif
      },
      /**
       * 检查本机支持的 SOTER生物认证方式
       */
      checkSoterAuth(): void {
        // 目前仅鸿蒙支持
        // #ifdef APP
        // 1、获取本机支持的 SOTER生物认证方式
        uni.checkIsSupportSoterAuthentication({
          success: (res1: CheckIsSupportSoterAuthenticationSuccess) => {
            if(res1.supportMode.length > 0) {
              // 读取记录
              let soterAuth: Array<UTSJSONObject> = getCache(cacheKey.AppSoterAuth as string) == '' ? [] : getCache(cacheKey.AppSoterAuth as string) as Array<UTSJSONObject>
              // 遍历
              res1.supportMode.forEach((mode: string, index: number) => {
                let name: string = ''
                if(mode == 'fingerPrint') {
                  name = '指纹'
                } else if(mode == 'facial') {
                  name = '人脸'
                } else if(mode == 'speech') {
                  name = '声纹'
                }
                let auth: UTSJSONObject = soterAuth.length > 0 ? soterAuth[index] : { mode: mode, name: name, enabled: null }
                // 2、获取设备内是否录入对应的生物信息（比如指纹、人脸）
                uni.checkIsSoterEnrolledInDevice({
                  checkAuthMode: mode,
                  complete: (res2: any) => {
                    if('isEnrolled' in res2) {
                      const isEnrolled: boolean = res2['isEnrolled'] as boolean
                      if(isEnrolled) {
                        // 已录入
                        if(auth['enabled'] == null) {
                          auth['enabled'] = false
                        }
                      } else {
                        // 未录入
                        auth['enabled'] = null
                      }
                    } else {
                      auth['enabled'] = null
                    }
                    // 修改记录
                    if(soterAuth.length > 0) {
                      soterAuth[index] = auth
                    } else {
                      soterAuth.push(auth)
                    }
                    // 存储记录
                    setCache(cacheKey.AppSoterAuth as string, soterAuth)
                  }
                } as CheckIsSoterEnrolledInDeviceOptions)
              })
            } else {
              removeCache(cacheKey.AppSoterAuth as string)
            }
          },
          fail: () => {
            removeCache(cacheKey.AppSoterAuth as string)
          }
        } as CheckIsSupportSoterAuthenticationOptions)
        // #endif
      }
    }
  }
</script>

<style>
  @import '@/static/styles/common.css';
</style>
