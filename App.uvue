<!-- 主组件（所有页面都是在这里进行切换的，是应用入口文件。但它本身不是页面，这里不能编写视图元素，也就是没有<template>） -->
<script lang="uts">
  export default {
    /**
     * 监听应用初始化（应用初始化完成时触发，全局只触发一次）
     * @param {OnLaunchOptions} options
     */
    onLaunch(options: OnLaunchOptions) {
      console.log('App Launch')
    },
    /**
     * 监听应用显示（应用启动，或从后台进入前台显示时触发）
     * @param {OnShowOptions} options
     */
    onShow(options: OnShowOptions) {
      console.log('App Show')
    },
    /**
     * 监听应用隐藏（应用从前台进入后台时触发）
     */
    onHide() {
      console.log('App Hide')
    },
    /**
     * 监听应用错误（应用发生脚本错误或API调用报错时触发）
     * @param {any} error
     */
    onError(error: any) {
      console.log('App Error', error)
    }
  }
</script>

<style>
  @import '@/static/fonts/iconfont.css';
  @import '@/static/styles/colorui.css';
</style>
