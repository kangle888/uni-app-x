<!-- 主组件（所有页面都是在这里进行切换的，是应用入口文件。但它本身不是页面，这里不能编写视图元素，也就是没有<template>） -->
<script lang="uts">
  import store from '@/store'

  export default {
    globalData: {  
      callbackId: 0
    },
    data() {
      return {
        abc: '123'
      }
    },
    /**
     * 监听应用初始化（应用初始化完成时触发，全局只触发一次）
     * @param {OnLaunchOptions} options
     */
    onLaunch(options: OnLaunchOptions): void {
      console.log('App Launch')
      this.setAndOnAppTheme()
    },
    /**
     * 监听应用显示（应用启动，或从后台进入前台显示时触发）
     * @param {OnShowOptions} options
     */
    onShow(options: OnShowOptions): void {
      console.log('App Show')
    },
    /**
     * 监听应用隐藏（应用从前台进入后台时触发）
     */
    onHide(): void {
      console.log('App Hide')
    },
    /**
     * 监听应用退出（仅支持 Android 和 HarmonyOS）
     */
    onExit() {
      console.log('App Exit')
      this.offAppTheme()
    },
    /**
     * 监听应用错误（应用发生脚本错误或API调用报错时触发）
     * @param {any} error
     */
    onError(error: any): void {
      console.log('App Error', error)
    },
    methods: {
      /**
       * 设置应用主题并开启监听系统主题变化
       */
      setAndOnAppTheme(): void {
        // #ifdef APP
        (store['changeTheme'] as (appTheme: 'auto' | 'light' | 'dark' | null) => void)(null)

        this.globalData.callbackId = uni.onOsThemeChange((res: OsThemeChangeResult) => {
          (store['changeTheme'] as (appTheme: 'auto' | 'light' | 'dark' | null) => void)(null)
        })
        // #endif
      },
      /**
       * 取消监听系统主题变化
       */
      offAppTheme(): void {
        // #ifdef APP
        uni.offOsThemeChange(this.globalData.callbackId)
        // #endif
      }
    }
  }
</script>

<style>
  @import '@/static/styles/common.css';
</style>
