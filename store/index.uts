type IState = {
  token: string,
  name: string,
  avatar: string,
  roles: string,
	permissions: string
}

const state = reactive({
  token: '',
  name: '',
  avatar: '',
  roles: '',
  permissions: ''
} as IState)

const setToken = (token: string): void => {
  state.token = token
}

const setName = (name: string): void => {
  state.name = name
}

const setAvatar = (avatar: string): void => {
  state.avatar = avatar
}

const setRoles = (roles: string): void => {
  state.roles = roles
}

const setPermissions = (permissions: string): void => {
  state.permissions = permissions
}

export default {
  state,
  setToken,
  setName,
  setAvatar,
  setRoles,
  setPermissions
} as UTSJSONObject
