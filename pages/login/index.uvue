<template>
  <view class="normal-login-container">
    <view class="logo-content align-center justify-center">
      <image style="width: 80px; height: 80px;" src="@/static/images/logo/logo.png" mode="widthFix" />
      <text class="title">轻舟移动端登录</text>
    </view>
    <view class="login-form-content">
      <view class="input-item flex-direction align-center">
        <view class="iconfont icon-user icon"></view>
        <input v-model="loginForm.username" type="text" class="input" placeholder="请输入账号" />
      </view>
      <view class="input-item flex-direction align-center">
        <view class="iconfont icon-password icon"></view>
        <input v-model="loginForm.password" type="password" class="input" placeholder="请输入密码" />
      </view>
      <view class="flex-direction align-center" v-if="captchaEnabled">
        <view class="input-item flex-direction align-center" style="width: 58%;">
          <view class="iconfont icon-code icon"></view>
          <input v-model="loginForm.code" type="text" class="input" placeholder="请输入验证码" />
        </view>
        <view class="login-code">
          <image :src="codeUrl" class="login-code-img" @click="getCode" />
        </view>
      </view>
      <view>
        <button class="login-btn cu-btn block bg-blue lg round" @click="handleLogin">登录</button>
      </view>
      <view class="xieyi flex-direction justify-center">
        <text class="text-grey">登录即代表同意</text>
        <text class="text-blue" @click="handleUserAgrement">《用户协议》</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { getCaptcha } from '@/api/login'

  const codeUrl = ref('')
  const captchaEnabled = ref(true)

  const loginForm = reactive({
    username: 'admin',
    password: 'admin123',
    code: '',
    uuid: ''
  })

  onLoad(() => {
    getCode()
  })

  /**
   * 获取验证码
   */
  function getCode() {
    getCaptcha().then((res: UTSJSONObject) => {
      captchaEnabled.value = res.captchaEnabled === undefined ? true : res.captchaEnabled
      if (captchaEnabled.value) {
        codeUrl.value = 'data:image/gif;base64,' + res.img
        loginForm.uuid = res.uuid
      }
    })
  }

  /**
   * 用户协议
   */
  function handleUserAgrement() {
    
  }

  function handleLogin() {
    
  }
</script>

