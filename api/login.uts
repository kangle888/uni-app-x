import request, { IRequest, IHeaders } from '@/utils/request'

/**
 * 登录方法
 * @param {string} username
 * @param {string} password
 * @param {string} code
 * @param {string} uuid
 */
export function login(username: string, password: string, code: string, uuid: string): Promise<any | null> {
  const data = {
    username,
    password,
    code,
    uuid
  } as UTSJSONObject
  return request({
    url: '/app-login',
    headers: {
      isToken: false
    } as IHeaders,
    method: 'POST',
    data: data
  } as IRequest)
}

/**
 * 获取用户详细信息
 */
export function getUserInfo(): Promise<any | null> {
  return request({
    url: '/getUserInfo',
    method: 'GET'
  } as IRequest)
}

/**
 * 退出方法
 */
export function logout(): Promise<any | null> {
  return request({
    url: '/logout',
    method: 'DELETE'
  } as IRequest)
}

/**
 * 获取验证码
 */
export function getCaptcha(): Promise<any | null> {
  return request({
    url: '/captcha',
    headers: {
      isToken: false
    } as IHeaders,
    method: 'GET',
    timeout: 20000
  } as IRequest)
}
