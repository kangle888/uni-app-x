type MockResponse = {
  code: number,
  description: string,
  data?: any
}

type MockRule = {
  pattern: string,
  method?: string,
  template?: any
}

const ok = (data: any): MockResponse => {
  return { code: 200, description: 'ok', data }
}

const fail = (description: string): MockResponse => {
  return { code: 500, description }
}

const match = (url: string, prefix: string): boolean => {
  return url == prefix || url.startsWith(prefix + '?')
}

const rand = (min: number, max: number): number => {
  return Math.floor(Math.random() * (max - min + 1)) + min
}

const randString = (len: number): string => {
  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789'
  let out = ''
  for (let i = 0; i < len; i++) {
    out += chars.charAt(rand(0, chars.length - 1))
  }
  return out
}

const randPick = (arr: Array<any>): any => {
  if (arr.length == 0) return null
  return arr[rand(0, arr.length - 1)]
}

const isObject = (val: any): boolean => {
  return val != null && typeof val == 'object' && !Array.isArray(val)
}

const renderTemplate = (tpl: any): any => {
  if (tpl == null) return null
  if (typeof tpl == 'string') {
    if (tpl.startsWith('@string(')) {
      const size = parseInt(tpl.replace('@string(', '').replace(')', ''))
      return randString(size)
    }
    if (tpl.startsWith('@int(')) {
      const parts = tpl.replace('@int(', '').replace(')', '').split(',')
      const min = parseInt(parts[0])
      const max = parseInt(parts[1])
      return rand(min, max)
    }
    if (tpl.startsWith('@pick(')) {
      const json = tpl.replace('@pick(', '').replace(')', '')
      try {
        const list = JSON.parse(json) as Array<any>
        return randPick(list)
      } catch (e) {
        return null
      }
    }
    return tpl
  }

  if (Array.isArray(tpl)) {
    return tpl.map((item) => renderTemplate(item))
  }

  if (isObject(tpl)) {
    const res: UTSJSONObject = {}
    Object.keys(tpl).forEach((key: string) => {
      res[key] = renderTemplate(tpl[key])
    })
    return res
  }

  return tpl
}

const rules: Array<MockRule> = []

export const addMockRule = (rule: MockRule): void => {
  rules.push(rule)
}

export const addMockRules = (list: Array<MockRule>): void => {
  list.forEach((rule: MockRule) => rules.push(rule))
}

export const handleMock = (req: UTSJSONObject): MockResponse | null => {
  const url = req['url'] as string
  const method = ((req['method'] as string) ?? 'GET').toUpperCase()

  for (let i = 0; i < rules.length; i++) {
    const rule = rules[i]
    if ((rule.method == null || rule.method == method) && match(url, rule.pattern)) {
      return ok(renderTemplate(rule.template ?? null))
    }
  }

  return null
}

// 默认 mock 规则（可按需扩展）
addMockRules([
  {
    pattern: '/auth/captcha',
    method: 'GET',
    template: { img: '', uuid: '@string(8)', captchaEnabled: true }
  },
  {
    pattern: '/auth/app-login',
    method: 'POST',
    template: { access_token: '@string(24)' }
  },
  {
    pattern: '/auth/getUserInfo',
    method: 'GET',
    template: {
      user: { nickName: '@pick(["测试用户","管理员","访客"])', avatar: '/static/images/avatar.jpg' },
      roles: ['admin'],
      permissions: ['*:*:*']
    }
  },
  {
    pattern: '/auth/logout',
    method: 'DELETE',
    template: null
  },
  {
    pattern: '/auth/app-scan',
    method: 'GET',
    template: { access_token: '@string(24)' }
  }
])
